---
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: 'en' | 'es' | 'ua';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<footer class="fixed bottom-0 left-0 w-full h-[300px] bg-[#050816] flex items-center justify-center z-0">
  <div class="w-full h-full absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-violet-900/20 via-transparent to-transparent opacity-50"></div>
  
  <div class="max-w-7xl w-full mx-auto px-4 flex flex-col md:flex-row justify-between items-center gap-8 relative z-10">
    <div class="flex flex-col gap-2">
      <h3 class="text-white font-bold text-2xl">{t('footer.connect')}</h3>
      <div class="text-secondary text-sm">
        &copy; {new Date().getFullYear()} Andrii Pap. <br/>
        {t('footer.copyright')}
      </div>
    </div>
    
    <div class="flex gap-8">
      <a 
        href="https://linkedin.com" 
        target="_blank" 
        rel="noopener noreferrer"
        class="text-secondary hover:text-white hover:scale-110 transition-all text-lg font-medium"
      >
        LinkedIn
      </a>
      <a 
        href="https://github.com" 
        target="_blank" 
        rel="noopener noreferrer"
        class="text-secondary hover:text-white hover:scale-110 transition-all text-lg font-medium"
      >
         GitHub
      </a>
      <a 
        href="mailto:contact@example.com" 
        class="text-secondary hover:text-white hover:scale-110 transition-all text-lg font-medium"
      >
         Email
      </a>
    </div>
  </div>
</footer>
