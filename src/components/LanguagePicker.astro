---
import { languages } from '../i18n/ui';
import { getLangFromUrl, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
---

<div class="fixed top-6 right-6 z-50">
    <div class="bg-black/20 backdrop-blur-lg border border-white/10 p-1.5 rounded-full flex gap-1">
        {Object.entries(languages).map(([label, name]) => (
            <a
                href={translatePath('/', label)}
                class:list={[
                    "px-3 py-1.5 text-xs font-medium rounded-full transition-all duration-300",
                    lang === label 
                        ? "bg-violet-500 text-white shadow-lg shadow-violet-500/25" 
                        : "text-neutral-400 hover:text-white hover:bg-white/5"
                ]}
            >
                {label.toUpperCase()}
            </a>
        ))}
    </div>
</div>
