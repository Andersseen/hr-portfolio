---
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: 'en' | 'es' | 'ua';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="max-w-7xl mx-auto px-4 pb-20 pt-0 relative z-20"> {/* Removed top padding entirely */}
    <div class="text-center mb-12">
        <h2 class="text-white font-black md:text-[50px] sm:text-[40px] xs:text-[30px] text-[30px]">
            {t('experience.title')}
        </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {/* Card 1 */}
        <div class="group relative bg-tertiary/20 rounded-3xl overflow-hidden border border-white/5 hover:border-violet-500/50 transition-all duration-500">
            {/* Pixel Grid Background */}
            <div class="absolute inset-0 bg-[url('/grid.svg')] opacity-0 group-hover:opacity-20 transition-opacity duration-500 bg-[length:30px_30px]"></div>
            <div class="absolute inset-0 bg-gradient-to-br from-violet-500/0 via-violet-500/0 to-violet-500/5 group-hover:from-violet-600/10 group-hover:via-transparent group-hover:to-transparent transition-all duration-500"></div>

            <div class="p-8 relative z-10 flex flex-col h-full">
                <div class="w-12 h-12 rounded-2xl bg-violet-500/10 flex items-center justify-center mb-6 text-violet-400 group-hover:scale-110 group-hover:bg-violet-500 group-hover:text-white transition-all duration-300 shadow-[0_0_15px_rgba(139,92,246,0.3)]">
                    <span class="font-bold text-xl">01</span>
                </div>
                <h3 class="text-white text-xl font-bold mb-3 group-hover:translate-x-1 transition-transform">{t('experience.user')}</h3>
                <p class="text-secondary text-sm leading-relaxed group-hover:text-white/80 transition-colors">
                    {t('experience.user.desc')}
                </p>
            </div>
        </div>

        {/* Card 2 */}
        <div class="group relative bg-tertiary/20 rounded-3xl overflow-hidden border border-white/5 hover:border-blue-500/50 transition-all duration-500">
             {/* Pixel Grid Background */}
             <div class="absolute inset-0 bg-[url('/grid.svg')] opacity-0 group-hover:opacity-20 transition-opacity duration-500 bg-[length:30px_30px]"></div>
             <div class="absolute inset-0 bg-gradient-to-br from-blue-500/0 via-blue-500/0 to-blue-500/5 group-hover:from-blue-600/10 group-hover:via-transparent group-hover:to-transparent transition-all duration-500"></div>

            <div class="p-8 relative z-10 flex flex-col h-full">
                <div class="w-12 h-12 rounded-2xl bg-blue-500/10 flex items-center justify-center mb-6 text-blue-400 group-hover:scale-110 group-hover:bg-blue-500 group-hover:text-white transition-all duration-300 shadow-[0_0_15px_rgba(59,130,246,0.3)]">
                     <span class="font-bold text-xl">02</span>
                </div>
                <h3 class="text-white text-xl font-bold mb-3 group-hover:translate-x-1 transition-transform">{t('experience.scalable')}</h3>
                <p class="text-secondary text-sm leading-relaxed group-hover:text-white/80 transition-colors">
                    {t('experience.scalable.desc')}
                </p>
            </div>
        </div>

        {/* Card 3 */}
        <div class="group relative bg-tertiary/20 rounded-3xl overflow-hidden border border-white/5 hover:border-pink-500/50 transition-all duration-500">
             {/* Pixel Grid Background */}
             <div class="absolute inset-0 bg-[url('/grid.svg')] opacity-0 group-hover:opacity-20 transition-opacity duration-500 bg-[length:30px_30px]"></div>
             <div class="absolute inset-0 bg-gradient-to-br from-pink-500/0 via-pink-500/0 to-pink-500/5 group-hover:from-pink-600/10 group-hover:via-transparent group-hover:to-transparent transition-all duration-500"></div>

            <div class="p-8 relative z-10 flex flex-col h-full">
                <div class="w-12 h-12 rounded-2xl bg-pink-500/10 flex items-center justify-center mb-6 text-pink-400 group-hover:scale-110 group-hover:bg-pink-500 group-hover:text-white transition-all duration-300 shadow-[0_0_15px_rgba(236,72,153,0.3)]">
                     <span class="font-bold text-xl">03</span>
                </div>
                <h3 class="text-white text-xl font-bold mb-3 group-hover:translate-x-1 transition-transform">{t('experience.collab')}</h3>
                <p class="text-secondary text-sm leading-relaxed group-hover:text-white/80 transition-colors">
                     {t('experience.collab.desc')}
                </p>
            </div>
        </div>
    </div>
</section>
