---
import { Icon } from 'astro-icon/components'

const  services = [
  {
    title: "Frontend Development",
    description: "Modern, responsive UIs with Angular, React, and Tailwind.",
    icon: "layout",
  },
  {
    title: "Backend & APIs",
    description: "Scalable serverless services with Hono, Node.js, and Cloudflare.",
    icon: "server",
  },
  {
    title: "Component Libraries",
    description: "Reusable UI libraries and design systems with Nx and Angular.",
    icon: "boxes",
  },
  {
    title: "Full-Stack Solutions",
    description: "End-to-end apps from database to frontend, optimized for performance.",
    icon: "code",
  },
];
---
<section id="about" class="min-h-screen py-20 px-4">
  <div class="group flex max-md:flex-col justify-center gap-2 w-[80%] mx-auto mb-10 mt-3">
    {services.map((item) => (
      <article class="bg-tertiary h-80 group/article relative w-full rounded-xl overflow-hidden 
        md:group-hover:[&:not(:hover)]:w-[20%] 
        md:group-focus-within:[&:not(:focus-within):not(:hover)]:w-[20%] 
        transition-all duration-300 ease-[cubic-bezier(.5,.85,.25,1.15)]
        before:absolute before:inset-x-0 before:bottom-0 before:h-1/3 
        before:bg-gradient-to-t before:from-black/50 before:transition-opacity 
        md:before:opacity-0 md:hover:before:opacity-100 focus-within:before:opacity-100
        after:opacity-0 md:group-hover:[&:not(:hover)]:after:opacity-100 
        md:group-focus-within:[&:not(:focus-within):not(:hover)]:after:opacity-100
        after:absolute after:inset-0 after:bg-white/30 after:backdrop-blur 
        after:rounded-lg after:transition-all focus-within:ring focus-within:ring-tertiary-300">
        
        <div class="absolute inset-0 text-white z-10 p-3 flex flex-col justify-end">
          <div class="mb-8 flex justify-center">
         <Icon name={item.icon} />
          </div>
          <h1 class="text-xl font-medium md:whitespace-nowrap md:truncate md:opacity-0 
            group-hover/article:opacity-100 group-focus-within/article:opacity-100 
            md:translate-y-2 group-hover/article:translate-y-0 
            group-focus-within/article:translate-y-0 
            transition duration-200 ease-[cubic-bezier(.5,.85,.25,1.8)] 
            group-hover/article:delay-300 group-focus-within/article:delay-300">
            {item.title}
          </h1>
          <span class="text-lg font-medium md:whitespace-nowrap md:truncate md:opacity-0 
            group-hover/article:opacity-100 group-focus-within/article:opacity-100 
            md:translate-y-2 group-hover/article:translate-y-0 
            group-focus-within/article:translate-y-0 
            transition duration-200 ease-[cubic-bezier(.5,.85,.25,1.8)] 
            group-hover/article:delay-500 group-focus-within/article:delay-500">
            {item.description}
          </span>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
[data-icon] {
    font-size: 5rem;
    color: var(--brand-color);
}
</style>