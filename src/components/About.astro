---
import { Icon } from 'astro-icon/components'
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: 'en' | 'es' | 'ua';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const services = [
  {
    title: t('about.leadership'),
    description: t('about.leadership.desc'),
    icon: "layout",
  },
  {
    title: t('about.architecture'),
    description: t('about.architecture.desc'),
    icon: "server",
  },
  {
    title: t('about.delivery'),
    description: t('about.delivery.desc'),
    icon: "boxes",
  },
  {
    title: t('about.frontend'),
    description: t('about.frontend.desc'),
    icon: "code",
  },
];
---

<section id="about" class="min-h-screen py-20 px-4 relative flex flex-col justify-center">
  <div class="text-center mb-10">
    <p class="sm:text-[18px] text-[14px] text-secondary uppercase tracking-wider">
      {t('about.overview')}
    </p>
    <h2 class="text-white font-black md:text-[60px] sm:text-[50px] xs:text-[40px] text-[30px]">
      {t('about.title')}
    </h2>
  </div>

  <div class="group flex max-md:flex-col justify-center gap-4 w-[90%] mx-auto mb-10 mt-3 h-[450px]">
    {services.map((item) => (
      <article class="bg-tertiary h-full group/article relative w-full rounded-3xl overflow-hidden 
        md:w-[22%] md:hover:w-[40%]
        md:group-hover:[&:not(:hover)]:w-[18%] 
        md:group-focus-within:[&:not(:focus-within):not(:hover)]:w-[18%] 
        transition-all duration-500 ease-[cubic-bezier(.5,.85,.25,1.15)]
        before:absolute before:inset-x-0 before:bottom-0 before:h-2/3 
        before:bg-gradient-to-t before:from-black/80 before:to-transparent before:transition-opacity 
        cursor-pointer shadow-lg border border-white/5
        hover:border-violet-500/50">
        
        {/* Background Gradient */}
        <div class="absolute inset-0 bg-gradient-to-br from-violet-900/20 to-indigo-900/20 opacity-50 group-hover/article:opacity-100 transition-opacity duration-500"></div>

        <div class="absolute inset-0 text-white z-10 p-6 flex flex-col justify-end overflow-hidden">
          <div class="mb-auto mt-4 transform md:translate-y-8 group-hover/article:translate-y-0 transition-transform duration-500">
             <div class="w-14 h-14 rounded-full bg-white/10 backdrop-blur-md flex items-center justify-center mb-4 text-violet-400">
               <Icon name={item.icon} class="w-7 h-7 flex-shrink-0" />
             </div>
          </div>

          {/* 
            Title and Text Container 
            Key Fix: The container is fixed width (w-[300px]) to prevent text reflow during width animation.
          */}
          <div class="relative min-w-[300px]"> 
            <h3 class="text-2xl font-bold mb-2 transform md:translate-y-4 group-hover/article:translate-y-0 transition-transform duration-500 delay-75 whitespace-normal leading-tight max-w-[200px] md:group-hover/article:max-w-full transition-[max-width]">
              {item.title}
            </h3>
            
            <p class="text-secondary text-sm leading-relaxed opacity-0 md:group-hover/article:opacity-100 transform translate-y-4 md:group-hover/article:translate-y-0 transition-all duration-500 delay-100 w-[280px]">
              {item.description}
            </p>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>